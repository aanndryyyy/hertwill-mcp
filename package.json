{
  "name": "hertwill-mcp",
  "version": "1.0.0",
  "description": "MCP server for the Hertwill dropshipping API: search the catalog, manage your import list, and sync products to your store.",
  "type": "module",
  "bin": {
    "hertwill-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hertwill",
    "dropshipping",
    "shopify",
    "woocommerce"
  ],
  "author": "Andry Pedak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aanndryyyy/hertwill-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
